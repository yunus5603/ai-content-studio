ENV=local
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/studio
# dev = trust the X-Dev-User header (local only). firebase = Google Identity Platform.
AUTH_MODE=dev
GCP_PROJECT_ID=
STORAGE_BACKEND=local
GCS_BUCKET=
LOCAL_STORAGE_DIR=./.media
LOCAL_URL_SECRET=change-me
PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:3000"]
ENABLE_DEBUG_OPERATIONS=true

# Billing. Leave the Stripe keys empty locally: owners get a "test mode" top-up button instead.
SIGNUP_CREDIT_USD=1.00
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PUBLIC_WEB_URL=http://localhost:3000
